# ==========================================
# Database Configuration (Free Open Source DBs)
# ==========================================
# 1. Neon PostgreSQL (Free Tier - Recommended):
# DATABASE_URL=postgresql://neondb_owner:yourpassword@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# 2. Supabase PostgreSQL (Free Tier):
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
#
# 3. Render / Aiven Free PostgreSQL:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
#
# 4. Local SQLite (Default / Fallback):
DATABASE_URL=sqlite:///./ingres_ai.db

# ==========================================
# Security & AI Configuration
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
